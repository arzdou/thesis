@article{goldman_dynamic_1963,
  title = {Dynamic {{Polarization}} by {{Thermal Mixing}} between {{Two Spin Systems}}},
  author = {Goldman, M. and Landesman, A.},
  date = {1963-10-15},
  journaltitle = {Physical Review},
  shortjournal = {Phys. Rev.},
  volume = {132},
