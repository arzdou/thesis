@article{larsen_deterministic_2019,
  title = {Deterministic Generation of a Two-Dimensional Cluster State},
  author = {Larsen, Mikkel V. and Guo, Xueshi and Breum, Casper R. and Neergaard-Nielsen, Jonas S. and Andersen, Ulrik L.},
