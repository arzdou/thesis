@article{yang_operation_2020,
  title = {Operation of a Silicon Quantum Processor Unit Cell above One Kelvin},
  author = {Yang, C. H. and Leon, R. C. C. and Hwang, J. C. C. and Saraiva, A. and Tanttu, T. and Huang, W. and Camirand Lemyre, J. and Chan, K. W. and Tan, K. Y. and Hudson, F. E. and Itoh, K. M. and Morello, A. and Pioro-Ladrière, M. and Laucht, A. and Dzurak, A. S.},
