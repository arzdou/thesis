@article{ruskuc_nuclear_2022b,
  title = {Nuclear Spin-Wave Quantum Register for a Solid-State Qubit},
  author = {Ruskuc, Andrei and Wu, Chun-Ju and Rochman, Jake and Choi, Joonhee and Faraon, Andrei},
