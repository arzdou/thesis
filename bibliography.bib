  author = {Mansir, J. and Conti, P. and Zeng, Z. and Pla, J. J. and Bertet, P. and Swift, M. W. and Van de Walle, C. G. and Thewalt, M. L. W. and Sklenard, B. and Niquet, Y. M. and Morton, J. J. L.},
  date = {2018-04},
  journaltitle = {Phys. Rev. Lett.},
  volume = {120},
  number = {16},
  pages = {167701},
  doi = {10.1103/PhysRevLett.120.167701},
  abstract = {We experimentally study the coupling of group V donor spins in silicon to mechanical strain, and measure strain-induced frequency shifts that are linear in strain, in contrast to the quadratic dependence predicted by the valley repopulation model (VRM), and therefore orders of magnitude greater than that predicted by the VRM for small strains \textbackslash textbarϵ\textbackslash textbar\textbackslash textless10−5. Through both tight-binding and first principles calculations we find that these shifts arise from a linear tuning of the donor hyperfine interaction term by the hydrostatic component of strain and achieve semiquantitative agreement with the experimental values. Our results provide a framework for making quantitative predictions of donor spins in silicon nanostructures, such as those being used to develop silicon-based quantum processors and memories. The strong spin-strain coupling we measure (up to 150 GHz per strain, for Bi donors in Si) offers a method for donor spin tuning—shifting Bi donor electron spins by over a linewidth with a hydrostatic strain of order 10−6—as well as opportunities for coupling to mechanical resonators.},
  year = {2018}
}

