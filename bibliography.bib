  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/sciadv.adu0581},
  abstract = {Pushing the sensitivity of nuclear magnetic resonance spectroscopy to the single spin level would have a major impact in chemistry and biology and is the goal of intense research efforts. We report magnetic resonance spectroscopy measurements of individual nuclear spins in a crystal coupled to a neighboring paramagnetic center, detected using microwave fluorescence at millikelvin temperatures. We observe real-time quantum jumps of the nuclear spin state, a proof of their individual nature. By driving the forbidden transitions of the coupled electron-nuclear spin system, we also achieve single-spin solid-effect dynamical nuclear polarization. Relying exclusively on microwave driving and microwave photon counting, the methods reported here are, in principle, applicable to a large number of electron-nuclear spin systems, in a wide variety of samples.},
  file = {/Users/jaime/Zotero/storage/7PB496N3/Travesedo et al. - 2025 - All-microwave spectroscopy and polarization of ind.pdf},
  year = {2025}
}

