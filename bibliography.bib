  keywords = {Quantum Physics},
  file = {/Users/jaime/Zotero/storage/75T4NMQD/Gundlapalli et al. - 2025 - High-Fidelity Single-Shot Readout and Selective Nuclear Spin Control for a Spin-12 Quantum Register.pdf;/Users/jaime/Zotero/storage/VQKPEYRW/2510.html},
