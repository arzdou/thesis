@article{witzel_electron_2010,
  title = {Electron {{Spin Decoherence}} in {{Isotope-Enriched Silicon}}},
  author = {Witzel, Wayne M. and Carroll, Malcolm S. and Morello, Andrea and Cywiński, Łukasz and Das Sarma, S.},
  date = {2010-10},
  journaltitle = {Phys. Rev. Lett.},
