@article{ma_uncovering_2014,
  title = {Uncovering Many-Body Correlations in Nanoscale Nuclear Spin Baths by Central Spin Decoherence},
  author = {Ma, Wen-Long and Wolfowicz, Gary and Zhao, Nan and Li, Shu-Shen and Morton, John J. L. and Liu, Ren-Bao},
