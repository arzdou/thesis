@article{kobayashi_engineering_2021,
  title = {Engineering Long Spin Coherence Times of Spin–Orbit Qubits in Silicon},
  author = {Kobayashi, Takashi and Salfi, Joseph and Chua, Cassandra and family=Heijden, given=Joost, prefix=van der, useprefix=true and House, Matthew G. and Culcer, Dimitrie and Hutchison, Wayne D. and Johnson, Brett C. and McCallum, Jeff C. and Riemann, Helge and Abrosimov, Nikolay V. and Becker, Peter and Pohl, Hans-Joachim and Simmons, Michelle Y. and Rogge, Sven},
