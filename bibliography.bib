@article{cywinski_how_2008,
  title = {How to Enhance Dephasing Time in Superconducting Qubits},
  author = {Cywiński, Łukasz and Lutchyn, Roman M. and Nave, Cody P. and Das Sarma, S.},
  date = {2008-05-13},
  journaltitle = {Physical Review B},
  shortjournal = {Phys. Rev. B},
  volume = {77},
