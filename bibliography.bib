  keywords = {Quantum information,Quantum metrology,Quantum simulation},
  file = {/Users/jaime/Zotero/storage/T4V2AB6X/van de Stolpe et al. - 2024 - Mapping a 50-spin-qubit network through correlated.pdf},
  year = {2024}
}

